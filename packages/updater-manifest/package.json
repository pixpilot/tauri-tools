{
  "name": "@pixpilot/tauri-updater-manifest",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "description": "Builds the latest.json a Tauri updater reads, from the signed bundles a release's build artifacts contain.",
  "author": "Mo Doaie <m.doaie@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ccpu/tauri-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccpu/tauri-tools.git",
    "directory": "packages/updater-manifest"
  },
  "bugs": {
    "url": "https://github.com/ccpu/tauri-tools/issues"
  },
  "keywords": [
    "tauri",
    "updater",
    "latest.json",
    "release",
    "github-actions",
    "code-signing",
    "minisign"
  ],
  "sideEffects": false,
  "exports": "./src/index.ts",
  "bin": {
    "tauri-updater-manifest": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "pnpm clean && git clean -xdf node_modules",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --watch",
    "test:ui:coverage": "vitest --ui --coverage --watch --hookTimeout=30000 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tsdown-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "eslint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "6.0.3",
    "vitest": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
